{
	"name": "options-chain-mcp",
	"version": "1.2.1",
	"description": "Options Chain MCP Server - options chains, quotes, expirations, and historical prices via Tradier or Alpaca",
	"type": "module",
	"main": "./build/index.js",
	"engines": {
		"node": ">=20"
	},
	"bin": {
		"options-chain-mcp": "build/index.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.stdio.json && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
		"dev:stdio": "tsx src/index.ts",
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run build",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"files": [
		"build",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"options",
		"options-chain",
		"stocks",
		"quotes",
		"greeks",
		"tradier",
		"alpaca",
		"finance",
		"mcp",
		"modelcontextprotocol",
		"mcp-server",
		"claude"
	],
	"author": "Blake Morgan",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/blake365/options-chain.git"
	},
	"homepage": "https://github.com/blake365/options-chain#readme",
	"bugs": {
		"url": "https://github.com/blake365/options-chain/issues"
	},
	"dependencies": {
		"@cloudflare/workers-oauth-provider": "^0.4.0",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"agents": "^0.0.100",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
		"@types/node": "^22.20.1",
		"tsx": "^4.23.11",
		"typescript": "^5.9.3",
		"wrangler": "~4.82.2"
	}
}
